# Copia este archivo a .env.local y rellena los valores.
# .env.local está en .gitignore, no lo subas a git.

# Project URL de tu proyecto de Supabase (Settings -> API -> Project URL)
SUPABASE_URL=https://tuproyecto.supabase.co

# Service Role key (Settings -> API -> Service Role / service_role)
# Es una clave secreta: nunca la expongas en el frontend.
SUPABASE_KEY=tu_service_role_key_aqui

# Puerto del servidor local (opcional, por defecto 3000)
PORT=3000
